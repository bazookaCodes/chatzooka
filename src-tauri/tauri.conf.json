{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chatzooka",
  "version": "0.1.0",
  "identifier": "dev.chatzooka.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chatzooka",
        "width": 480,
        "height": 820,
        "minWidth": 320,
        "minHeight": 400,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Twitch and YouTube chat in one window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
