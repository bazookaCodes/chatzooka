{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chatzooka",
  "version": "../package.json",
  "identifier": "dev.chatzooka.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chatzooka",
        "width": 480,
        "height": 820,
        "minWidth": 320,
        "minHeight": 400,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "shortDescription": "Twitch and YouTube chat in one window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRkQ2MkZFQTFBQTZCQkMKUldTOGE2cWgvbUw5VWZZcVBpdXNaVHhpd2FibmZhMEFyWCtza2JHbUlYOG9oOUNzSFJsQnUxQUwK",
      "endpoints": ["https://github.com/bazookaCodes/chatzooka/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
